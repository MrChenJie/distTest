    "optimize-css-assets-webpack-plugin": "5.0.3",
    "file-loader": "2.0.0",
    "mini-css-extract-plugin": "0.9.0",
    "less-loader": "5.0.0",
    "@babel/cli": "^7.8.4",
    "webpack": "4.42.1",
    "react": "16.12.0",
    "react-router": "4.3.1",
    "react-router-dom": "4.3.1",
    "react-dom": "16.12.0",
    "html-webpack-plugin": "4.0.0-alpha.2",
    "typescript": "3.8.2",
    "choerodon-ui": "^0.8.58",
    "hzero-ui": "1.0.73",
    "react-dnd": "10.0.2",
    "react-dnd-html5-backend": "10.0.2",
    "conventional-changelog": "~3.0.6",
    "browserslist": "4.6.0",
    "caniuse-lite": "1.0.30000971",
    "less": "~3.9.0",
    "srm-front-boot": "1.5.0",
    "hzero-front": "1.3.4-1",
    "hzero-front-hcuz": "1.3.2-beta.2",
    "hzero-front-himp": "1.3.1",
    "hzero-front-hiam": "1.3.4-1",
    "hzero-front-hpfm": "1.3.4",

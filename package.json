  "description": "srm-front-core",
  "author": "",
  "version": "0.0.1",
  "eslintConfig": {
    "extends": "react-app"
  },
  "scripts": {
    "start": "hzero-cli start HTTPS=true SSL_CRT_FILE=./.cert/rootCA.pem SSL_KEY_FILE=./.cert/key.pem",
    "postinstall": "patch-package",
    "start:mock": "cross-env NODE_PROFILE=mock hzero-cli start",
    "build": "cross-env NODE_OPTIONS='--max_old_space_size=8196' hzero-cli build --all-packages",
    "build:test": "cross-env NODE_PROFILE=test NODE_OPTIONS='--max_old_space_size=8196' hzero-cli build --all-packages",
    "build:test-fs": "cross-env NODE_PROFILE=test-fs NODE_OPTIONS='--max_old_space_size=8196' hzero-cli build --all-packages",
    "build:uat": "cross-env NODE_PROFILE=uat NODE_OPTIONS='--max_old_space_size=8196' hzero-cli build --all-packages",
    "build:uatnew1": "cross-env NODE_PROFILE=uatnew1 NODE_OPTIONS='--max_old_space_size=8196' hzero-cli build --all-packages",
    "build:prod-app01": "cross-env NODE_PROFILE=prod-app01 NODE_OPTIONS='--max_old_space_size=8196' hzero-cli build --all-packages",
    "build:prod-app02": "cross-env NODE_PROFILE=prod-app02 NODE_OPTIONS='--max_old_space_size=8196' hzero-cli build --all-packages",
    "build:production": "cross-env NODE_PROFILE=production NODE_OPTIONS='--max_old_space_size=8196' hzero-cli build --only-build-micro --all-packages",
    "build:all-ms": "hzero-cli build --only-build-micro --all-packages",
    "build:test-all-ms": "cross-env NODE_PROFILE=test NODE_OPTIONS='--max_old_space_size=8196' hzero-cli build --only-build-micro --all-packages",
    "build:prod-app01-all-ms": "cross-env NODE_PROFILE=prod-app01 NODE_OPTIONS='--max_old_space_size=8196' hzero-cli build --only-build-micro --all-packages",
    "build:prod-app02-all-ms": "cross-env NODE_PROFILE=prod-app02 NODE_OPTIONS='--max_old_space_size=8196' hzero-cli build --only-build-micro --all-packages",
    "build:ms": "cross-env NODE_OPTIONS='--max_old_space_size=8196' hzero-cli build --only-build-micro",
    "build:ms-test": "cross-env NODE_PROFILE=test NODE_OPTIONS='--max_old_space_size=8196' hzero-cli build --only-build-micro",
    "build:ms-test-fs": "cross-env NODE_PROFILE=test-fs NODE_OPTIONS='--max_old_space_size=8196' hzero-cli build --only-build-micro",
    "build:ms-uat": "cross-env NODE_PROFILE=uat NODE_OPTIONS='--max_old_space_size=8196' hzero-cli build --only-build-micro",
    "build:ms-uatnew1": "cross-env NODE_PROFILE=uatnew1 NODE_OPTIONS='--max_old_space_size=8196' hzero-cli build --only-build-micro",
    "build:ms-prod-app01": "cross-env NODE_PROFILE=prod-app01 NODE_OPTIONS='--max_old_space_size=8196' hzero-cli build --only-build-micro",
    "build:ms-prod-app02": "cross-env NODE_PROFILE=prod-app02 NODE_OPTIONS='--max_old_space_size=8196' hzero-cli build --only-build-micro",
    "build:ext-ms": "cross-env BUILD_PUBLIC_MS=true BUILD_DIST_PATH=./dist-ext BUILD_SKIP_PARENT=true hzero-cli build --only-build-micro",
    "build:analyze": "cross-env ANALYZE=true hzero-cli build",
    "build:dll": "hzero-cli build --build-dll",
    "build:dll-dev": "hzero-cli build --build-dll --build-dll-dev",
    "build:dll-test": "cross-env NODE_PROFILE=test node ./node_modules/hzero-cli/bin/hzero-cli.js build --build-dll",
    "build:dll-prod-app01": "cross-env NODE_PROFILE=prod-app01 node ./node_modules/hzero-cli/bin/hzero-cli.js build --build-dll",
    "build:parent": "hzero-cli build --only-build-parent",
    "build:parent-test": "cross-env NODE_PROFILE=test hzero-cli build --only-build-parent",
    "build:parent-prod-app01": "cross-env NODE_PROFILE=prod-app01 hzero-cli build --only-build-parent",
    "transpile": "hzero-cli transpile --all",
    "lint": "eslint 'src/**/*.{js,jsx,tsx,ts}' && npm run lint:style && tsc --noEmit --emitDeclarationOnly false",
    "lint:fix": "eslint --quiet --fix 'src/**/*.{js,jsx,tsx,ts}' && npm run lint:style",
    "lint:style": "stylelint \"src/**/*.less\" --syntax less",
    "lint-staged": "lint-staged && lerna run lint-staged",
    "bootstrap": "yarn  --registry http://nexus.saas.hand-china.com/content/groups/srm-npm-group/",
    "test": "node scripts/test.js",
    "changelog": "node node_modules/.bin/conventional-changelog -p eslint -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md",
    "prettier": "prettier --write ./src/**/**/**/*",
    "tree": "tree -I node_modules -L 3",
    "release": "standard-version"
  },
  "husky": {
    "hooks": {
      "post-merge": "git submodule update",
      "post-checkout": "git submodule update"
    }
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 10",
    "not op_mini all"
  ],
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "resolver": "jest-pnp-resolver",
    "setupFiles": [
      "react-app-polyfill/jsdom"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/src/**/?(*.)(spec|test).{js,jsx,ts,tsx}"
    ],
    "testEnvironment": "jsdom",
    "testURL": "http://localhost",
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "<rootDir>/node_modules/babel-jest",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|ts|tsx|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "web.js",
      "js",
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ],
    "watchPlugins": [
      "<rootDir>/node_modules/jest-watch-typeahead/filename.js",
      "<rootDir>/node_modules/jest-watch-typeahead/testname.js"
    ]
  },
  "lint-staged": {
    "src/**/*.{js,jsx,tsx,ts}": "eslint --quiet --fix",
    "src/**/*.less": "stylelint --syntax less",
    "src/**/*.{js,ts,tsx,jsx,less}": [
      "prettier --write",
      "git add"
    ]
  },
  "workspaces": [
    "packages/*"
  ]
}
